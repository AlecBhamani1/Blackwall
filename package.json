{
  "name": "blackwall",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop agent harness",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm --prefix ui run build",
    "check": "npm --prefix ui run check",
    "commitlint": "commitlint",
    "desktop": "cd src/app && ../../ui/node_modules/.bin/tauri dev",
    "desktop:build": "cd src/app && ../../ui/node_modules/.bin/tauri build",
    "dev": "npm --prefix ui run dev",
    "hooks:install": "lefthook install",
    "prepare": "lefthook install",
    "test": "npm --prefix ui run test:run",
    "verify": "npm run check && npm run test && npm run build"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "lefthook": "2.1.10"
  }
}
